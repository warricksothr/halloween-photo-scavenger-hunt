# arkham-hunt.service — the party server as a systemd USER unit.
#
# A user unit (not a system unit) matches the hosting decision in
# docs/design.md: one small VPS, one deployment, run as an unprivileged
# login user. No root, no container — the app is one uvicorn process
# serving both the API and the built PWA (increment 10).
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/arkham-hunt.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now arkham-hunt
#   loginctl enable-linger "$USER"   # survive logout — the party must
#                                    # not depend on your SSH session
#
# The admin credentials come from the environment, NOT the unit file
# (secrets do not live in committed files — repo policy). Put them in an
# EnvironmentFile that stays out of git:
#   ~/.config/arkham-hunt.env, mode 0600:
#     ARKHAM_ADMIN_USERNAME=you
#     ARKHAM_ADMIN_PASSWORD_HASH=<output of `python -m app.security 'pw'`
#                                 run from the repo's server/ venv>
#     ARKHAM_OIDC_ISSUER=https://<authentik-host>/application/o/<slug>/
#     ARKHAM_OIDC_CLIENT_ID=<client id>
#     ARKHAM_OIDC_CLIENT_SECRET=<client secret>
#     ARKHAM_ADMIN_API_TOKEN=<random secret; scripted admin access>
#     ARKHAM_ERROR_DSN=https://<key>@glitchtip.nulloctet.com/1
#     ARKHAM_TRACES_SAMPLE_RATE=0.1
#     ARKHAM_ENVIRONMENT=production
#     ARKHAM_RELEASE=<git revision>
#
# The ARKHAM_OIDC_* trio turns on Authentik single sign-on for hosts and
# moderators (app/oidc.py). All three are required together; with any one
# missing the app starts with SSO off and the local password below stays
# the only way in. The local password is break-glass even with SSO on, so
# an Authentik outage never locks the host out. Set ARKHAM_OIDC_SCOPES if
# the groups mapping has its own scope name (the default does not request
# it). This file is an EnvironmentFile: bare NAME=value, never `export`.
# See deploy/RUNBOOK.md §6.
#
# ARKHAM_ADMIN_API_TOKEN is an optional standing credential for scripts
# with no browser: send it as `Authorization: Bearer <token>` and skip the
# cookie jar and CSRF pair. Unset means the feature is off. Unlike a
# session it does not expire on restart, so rotate it by editing this file
# and restarting.
#
# ARKHAM_ERROR_DSN turns on server error/trace reporting to GlitchTip
# (app/errors.py, ADR 0017). Unset means reporting is off, which is the
# right default for a checkout. The server-side DSN is a public ingest
# key but still belongs in this uncommitted file rather than the unit.
# The browser DSN is baked into web/dist at build time (VITE_ERROR_DSN).

[Unit]
Description=Arkham Halloween photo scavenger hunt (uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust to the checkout location on the host.
WorkingDirectory=%h/arkham/server
EnvironmentFile=%h/.config/arkham-hunt.env
# --factory: create_app() reads the env at startup, so each restart
# picks up fresh credentials/config without an edit here.
ExecStart=%h/arkham/server/.venv/bin/uvicorn app.main:create_app \
    --factory --host 127.0.0.1 --port 8000 \
    --proxy-headers --forwarded-allow-ips=127.0.0.1
# Binds loopback only — nginx is the public face (deploy/nginx.conf)
# and terminates TLS. Nothing but the proxy should reach :8000.
#
# --proxy-headers makes uvicorn read X-Forwarded-For, but only from
# 127.0.0.1 (--forwarded-allow-ips), so a direct request cannot forge its
# IP. nginx sends the header (deploy/nginx.conf). Together they give the
# rate limiter the real client IP (app/ratelimit.py, ADR 0015); without
# both, every request looks like 127.0.0.1.

# One night, no second chances: restart fast and forever if the process
# dies. SQLite + WAL means a crash loses at most the uncommitted write.
Restart=always
RestartSec=2

# Hardening (compatible with a user unit). The whole filesystem is
# read-only except the data directory — the DB, its WAL/SHM files, and
# the photos are the only state this process writes.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/arkham/data

[Install]
WantedBy=default.target
