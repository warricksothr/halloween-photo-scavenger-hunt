# Reference screenshots are copyrighted (Rocksteady/WB) and must not be
# committed. Fetch your own copies from the URLs listed in
# docs/reference/THEME-NOTES.md.
docs/reference/*.jpg
docs/reference/*.jpeg
docs/reference/*.png
docs/reference/*.webp

# Runtime data: SQLite database and uploaded player photos.
data/

# Secrets (compose interpolation source) — never commit.
.env

# Deployment targets: host names, addresses, paths, and group names for
# real environments. Local only. Everything here is ignored; only the
# convention's own files are committed, whitelisted with the `!` lines
# below. deploy/targets/.gitignore repeats this inside the directory, so
# either rule alone keeps a note out of the repository.
deploy/targets/*
!deploy/targets/.gitignore
!deploy/targets/README.md

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.coverage*
.ruff_cache/
*.egg-info/

# Node / Vite
node_modules/
web/dist/
web/.playwright-results/
.deploy-smoke-results/
# Local error-reporting DSN for a dev build (Vite reads web/.env.local).
web/.env.local
web/.env.*.local
